{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "excludeFiles": "{web/**,previous_seasons/**,tests/**,thoughts/**}" }
    },
    { "src": "web/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/lineup", "dest": "/api/index.py?__route=lineup" },
    { "src": "/api/transaction", "dest": "/api/index.py?__route=transaction" },
    { "src": "/api/rule-changes", "dest": "/api/index.py?__route=rule-changes" },
    { "src": "/api/nfl-draft", "dest": "/api/index.py?__route=nfl-draft" },
    { "src": "/api/team-name", "dest": "/api/index.py?__route=team-name" },
    { "src": "/api/team-avatar", "dest": "/api/index.py?__route=team-avatar" },
    {
      "src": "/(data/index\\.json)",
      "dest": "/web/$1",
      "headers": { "Cache-Control": "public, max-age=60, stale-while-revalidate=300" }
    },
    {
      "src": "/(data/seasons/\\d+/(?:meta|standings|live|rosters|draft_picks)\\.json)",
      "dest": "/web/$1",
      "headers": { "Cache-Control": "public, max-age=60, stale-while-revalidate=300" }
    },
    {
      "src": "/(data/seasons/\\d+/weeks/week_\\d+\\.json)",
      "dest": "/web/$1",
      "headers": { "Cache-Control": "public, max-age=60, stale-while-revalidate=300" }
    },
    {
      "src": "/(data/shared/(?:hall_of_fame|transactions|drafts)\\.json)",
      "dest": "/web/$1",
      "headers": { "Cache-Control": "public, max-age=60, stale-while-revalidate=300" }
    },
    {
      "src": "/(data/shared/.*\\.json)",
      "dest": "/web/$1",
      "headers": { "Cache-Control": "public, max-age=86400, stale-while-revalidate=2592000" }
    },
    {
      "src": "/(data_\\d{4}\\.json)",
      "dest": "/web/$1",
      "headers": { "Cache-Control": "public, max-age=86400, stale-while-revalidate=2592000" }
    },
    {
      "src": "/(data\\.json)",
      "dest": "/web/$1",
      "headers": { "Cache-Control": "public, max-age=60, stale-while-revalidate=300" }
    },
    {
      "src": "/(.*)",
      "dest": "/web/$1",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://qpfl-scoring.vercel.app; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Content-Type-Options": "nosniff"
      }
    }
  ]
}
